<Window x:Class="TpacTool.GalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TpacTool"
        mc:Ignorable="d"
        Title="Asset Gallery" Height="760" Width="1240" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance local:GalleryViewModel}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <SolidColorBrush x:Key="TileBackground" Color="#FF3A3D42"/>
        <SolidColorBrush x:Key="TileSelectedBorder" Color="#FF2F8CFF"/>

        <DataTemplate x:Key="TileTemplate" DataType="{x:Type local:GalleryItem}">
            <Border x:Name="Tile" Width="{Binding DataContext.TileWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                    Margin="3" Padding="4" CornerRadius="4" BorderThickness="2" BorderBrush="Transparent"
                    Background="#FFF4F4F4" ToolTip="{Binding ToolTip}" Cursor="Hand"
                    MouseLeftButtonDown="Tile_MouseLeftButtonDown">
                <StackPanel>
                    <Grid Height="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Border Background="{StaticResource TileBackground}" CornerRadius="3"/>
                        <TextBlock Text="{Binding Placeholder}" Foreground="#FF9AA0A6" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="5" HorizontalAlignment="Left"
                                  VerticalAlignment="Top" IsHitTestVisible="False"/>
                        <Border Background="#C0202020" CornerRadius="3" Padding="4,1" Margin="4"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Visibility="{Binding IsRigged, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="rigged" Foreground="White" FontSize="10"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Name}" Margin="1,4,1,0" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Package}" Margin="1,0,1,0" FontSize="10" Foreground="#FF777777"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource TileSelectedBorder}"/>
                    <Setter TargetName="Tile" Property="Background" Value="#FFDCEBFF"/>
                </DataTrigger>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tile" Property="Background" Value="#FFE6EEF8"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- toolbar -->
        <Border Grid.Row="0" Grid.Column="0" Padding="8,6" Background="#FFF0F0F0" BorderBrush="#FFD5D5D5" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <ComboBox DockPanel.Dock="Left" Width="100" Height="24" ItemsSource="{Binding KindItems}" SelectedIndex="{Binding KindIndex, Mode=TwoWay}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                    <TextBlock Text="Size" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#FF555555"/>
                    <Slider Width="90" Minimum="64" Maximum="256" SmallChange="16" LargeChange="32" VerticalAlignment="Center"
                            Value="{Binding ThumbnailSize, Mode=TwoWay}" IsSnapToTickEnabled="True" TickFrequency="16"/>
                </StackPanel>
                <Grid Margin="8,0,0,0">
                    <TextBox x:Name="SearchBox" Height="24" VerticalContentAlignment="Center" Padding="4,0,22,0"
                             Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                             ToolTip="Filter by name or package. Separate words with spaces to match all of them."/>
                    <TextBlock Text="Search assets…" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#FF999999" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Content="✕" Width="20" Height="20" HorizontalAlignment="Right" Margin="0,0,2,0"
                            Background="{x:Null}" BorderBrush="{x:Null}" Command="{Binding ClearFilterCommand}" ToolTip="Clear filter"/>
                </Grid>
            </DockPanel>
        </Border>

        <!-- gallery -->
        <ItemsControl x:Name="Gallery" Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Rows}" Background="White"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard"
                      VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                      SizeChanged="Gallery_SizeChanged" Padding="5">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer CanContentScroll="True" Focusable="False" Padding="{TemplateBinding Padding}"
                                  VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:GalleryRow}">
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TileTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- selection bar -->
        <Border Grid.Row="2" Grid.Column="0" Padding="8,5" Background="#FFF0F0F0" BorderBrush="#FFD5D5D5" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="Select all shown" Padding="8,2" Command="{Binding SelectAllCommand}"/>
                    <Button Content="Select none" Padding="8,2" Margin="4,0,0,0" Command="{Binding SelectNoneCommand}"/>
                    <Button Content="Invert" Padding="8,2" Margin="4,0,0,0" Command="{Binding InvertSelectionCommand}"/>
                    <CheckBox Content="Show selected only" Margin="10,0,0,0" VerticalAlignment="Center" IsChecked="{Binding ShowSelectedOnly, Mode=TwoWay}"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding VisibleSummary}" VerticalAlignment="Center" Foreground="#FF666666"/>
                <TextBlock Text="{Binding SelectionSummary}" VerticalAlignment="Center" Margin="12,0" FontWeight="SemiBold"/>
            </DockPanel>
        </Border>

        <!-- export panel -->
        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Background="#FFF7F7F7" BorderBrush="#FFD5D5D5" BorderThickness="1,0,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="10">
                    <Button Height="34" FontWeight="SemiBold" Content="{Binding ExportButtonText}" Command="{Binding ExportCommand}"
                            IsEnabled="{Binding IsIdle}" ToolTip="Export every selected asset (in all tabs) together with all of its textures"/>
                    <ProgressBar Height="8" Margin="0,8,0,0" Value="{Binding ExportProgress, Mode=OneWay}"
                                 Visibility="{Binding IsExporting, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding ExportStatus}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11" Foreground="#FF444444"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Cancel" Padding="10,2" Command="{Binding CancelExportCommand}"
                                Visibility="{Binding IsExporting, Converter={StaticResource BoolToVisibility}}"/>
                        <Button Content="Open output folder" Padding="10,2" Command="{Binding OpenOutputCommand}"
                                Visibility="{Binding CanOpenOutput, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10" IsEnabled="{Binding IsIdle}">
                        <TextBlock Text="Export" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <TextBlock Text="Output folder" Foreground="#FF555555"/>
                        <DockPanel Margin="0,2,0,8">
                            <Button DockPanel.Dock="Right" Content="…" Width="26" Margin="4,0,0,0" Command="{Binding BrowseOutputCommand}" ToolTip="Browse"/>
                            <TextBox Height="24" VerticalContentAlignment="Center" Text="{Binding OutputDir, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        </DockPanel>

                        <TextBlock Text="Model format" Foreground="#FF555555"/>
                        <ComboBox Margin="0,2,0,8" ItemsSource="{Binding FormatItems}" SelectedIndex="{Binding FormatIndex, Mode=TwoWay}"/>

                        <TextBlock Text="Texture format" Foreground="#FF555555"/>
                        <ComboBox Margin="0,2,0,8" ItemsSource="{Binding TextureFormatItems}" SelectedIndex="{Binding TextureFormatIndex, Mode=TwoWay}"/>

                        <CheckBox Content="One folder per asset" Margin="0,2,0,8" IsChecked="{Binding OneFolderPerAsset, Mode=TwoWay}"
                                  ToolTip="On: output/&lt;asset&gt;/&lt;asset&gt;.fbx with its textures next to it.&#x0a;Off: models in the output folder, textures in a sub folder named after each model."/>

                        <GroupBox Header="Rigged models" Padding="4" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Skeleton" Foreground="#FF555555"/>
                                <ComboBox Margin="0,2,0,2" ItemsSource="{Binding SkeletonItems}" SelectedIndex="{Binding SkeletonIndex, Mode=TwoWay}"/>
                                <TextBlock Text="{Binding HumanSkeletonInfo}" FontSize="11" Foreground="#FF777777" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="Rig target" Foreground="#FF555555"/>
                                <ComboBox Margin="0,2,0,6" ItemsSource="{Binding RigTargetItems}" SelectedIndex="{Binding RigTargetIndex, Mode=TwoWay}"/>
                                <StackPanel Visibility="{Binding IsM2Target, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,6">
                                    <TextBlock Text="Custom armatures folder (optional)" Foreground="#FF555555"/>
                                    <DockPanel Margin="0,2,0,4">
                                        <Button DockPanel.Dock="Right" Content="…" Width="26" Margin="4,0,0,0" Command="{Binding BrowseM2Command}" ToolTip="Browse"/>
                                        <TextBox Height="24" VerticalContentAlignment="Center" Text="{Binding M2ArmaturesDir, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                    </DockPanel>
                                    <TextBlock Text="Medieval 2 skeleton" Foreground="#FF555555"/>
                                    <ComboBox Margin="0,2,0,4" ItemsSource="{Binding M2SkeletonItems}" SelectedIndex="{Binding M2SkeletonIndex, Mode=TwoWay}"/>
                                    <CheckBox Content="Include Medieval 2 animations" Margin="0,2,0,4" IsChecked="{Binding M2IncludeAnimations, Mode=TwoWay}"
                                              ToolTip="Adds the chosen skeleton's animations (from the toolkit's sample files) to the FBX, so the armour can be previewed in the M2 poses. FBX only."/>
                                    <TextBlock Text="{Binding M2Info}" FontSize="11" Foreground="#FF777777" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox Content="Convert A-pose to T-pose" Margin="0,2" IsChecked="{Binding TPoseChecked, Mode=TwoWay}" IsEnabled="{Binding IsBannerlordTarget}"
                                          ToolTip="Rotates the skeleton's arms to a T-pose and deforms the skinned meshes to match."/>
                                <CheckBox Content="Straighten elbows" Margin="18,2,0,2" IsChecked="{Binding StraightenElbows, Mode=TwoWay}"
                                          IsEnabled="{Binding TPoseChecked}"
                                          ToolTip="Also straighten the forearms so the whole arm is level."/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Options" Padding="4">
                            <StackPanel>
                                <CheckBox Content="Export all LODs" Margin="0,2" IsChecked="{Binding AllLods, Mode=TwoWay}"/>
                                <CheckBox Content="Only link diffuse textures in the model" Margin="0,2" IsChecked="{Binding DiffuseOnly, Mode=TwoWay}"
                                          ToolTip="All textures are still written to disk; only the diffuse map is assigned in the model's materials."/>
                                <CheckBox Content="Larger scale (x10)" Margin="0,2" IsChecked="{Binding LargerScale, Mode=TwoWay}"/>
                                <CheckBox Content="-Y forward" Margin="0,2" IsChecked="{Binding NegYForward, Mode=TwoWay}"/>
                                <CheckBox Content="Y up (OBJ)" Margin="0,2" IsChecked="{Binding YUp, Mode=TwoWay}"/>
                            </StackPanel>
                        </GroupBox>

                        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" FontSize="11" Foreground="#FF777777"
                                   Text="Click tiles to select, shift-click to select a range, double-click to open an asset in the main window. Selections are kept across the Models / Textures / Materials tabs."/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
